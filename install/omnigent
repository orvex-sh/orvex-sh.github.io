#!/usr/bin/env bash
# orvex.sh/install/omnigent — install the orvex build of Omnigent.
#
#   curl -fsSL orvex.sh/install/omnigent | bash
#
# Installs the prebuilt wheels attached to a tagged GitHub release with uv,
# wires up PATH, and records an install ledger — the same shape as omnigent's
# own scripts/install_oss.sh, which installs a published wheel from PyPI. The
# orvex line is not on PyPI (PyPI's `omnigent` is upstream 0.9.0) and the repo
# is private, so the release assets stand in for the index and `gh` supplies
# the authentication. The wheel bundles the prebuilt web UI, so the default
# install needs no Node, no pnpm, and runs no build.
#
# Releases are cut from `mcp`: that is where the agent / MCP work lands, and
# the release workflow refuses to build from any other branch. `orvex` is kept
# deliberately lean and lags those fixes.
#
#   --release X   install a specific release, e.g. `0.10.1` or `orvex-v0.10.1`
#                 (default: the pinned release below)
#   --ref REF     build from a git ref instead (development; needs Node 22+ and
#                 pnpm, and takes minutes rather than seconds)
#
# The source path clones and builds rather than `uv tool install git+...` on
# purpose — that builds an sdist, the sdist vendors no `web/`, and the SPA step
# then silently skips, producing an API-only server that still exits 0.
#
# Env overrides:
#   ORVEX_OMNIGENT_RELEASE     release tag to install (default: pinned below)
#   ORVEX_OMNIGENT_REF         git ref — setting it switches to a source build
#   ORVEX_OMNIGENT_REPO        git URL (default: git@github.com:orvexai/omnigent)
#   ORVEX_OMNIGENT_PYTHON      python version for the tool venv (default: 3.12)
#   ORVEX_OMNIGENT_EXTRAS      optional-dependency extras (comma-separated)
#   ORVEX_OMNIGENT_SERVER      server URL printed in the next-steps host command
#   ORVEX_OMNIGENT_SCRIPT_URL  self-bootstrap source (default: this URL)
#
# Examples:
#   curl -fsSL orvex.sh/install/omnigent | bash                          # pinned release
#   curl -fsSL orvex.sh/install/omnigent | bash -s -- --release 0.10.1   # another release
#   curl -fsSL orvex.sh/install/omnigent | bash -s -- --ref mcp          # build mcp HEAD
#
# Note the env overrides must prefix `bash`, not `curl` — in `VAR=x curl … |
# bash` the shell assigns VAR to curl only and the script never sees it:
#   curl -fsSL orvex.sh/install/omnigent | ORVEX_OMNIGENT_RELEASE=orvex-v0.10.1 bash
#
# Needs `gh` authenticated against orvexai (release assets are private); the
# source path needs SSH access to git@github.com:orvexai/omnigent instead.

set -euo pipefail

REPO_URL="${ORVEX_OMNIGENT_REPO:-git@github.com:orvexai/omnigent}"
# GitHub repo the release assets are pulled from, in owner/name form.
RELEASE_REPO="${ORVEX_OMNIGENT_RELEASE_REPO:-orvexai/omnigent}"
# Release installed when none is requested. Bump this when a new one ships.
# The orvex line numbers its own releases: the version in pyproject.toml is
# upstream's, it names the line the fork rebased onto rather than any build the
# fork controls, and it moves on the next rebase. Tags carry the real version,
# and the packages are stamped from the tag at build time.
# Pinned rather than resolved as "latest" on purpose: a draft release is
# invisible to the latest-release API, so auto-resolution would skip the very
# release a human is still reviewing.
RELEASE="${ORVEX_OMNIGENT_RELEASE:-${ORVEX_OMNIGENT_VERSION:-orvex-v0.10.0}}"
# Empty means install a release. Setting a ref switches to a source build.
GIT_REF="${ORVEX_OMNIGENT_REF:-}"
PYTHON_VERSION="${ORVEX_OMNIGENT_PYTHON:-3.12}"
EXTRAS="${ORVEX_OMNIGENT_EXTRAS:-}"
SERVER_URL="${ORVEX_OMNIGENT_SERVER:-}"
NON_INTERACTIVE=false
VERBOSE=false
SKIP_WEB_UI=false

# Pillow is NOT a declared dependency of omnigent — declaring it churned
# thousands of lines of lockfile — but the runner needs it to bound browser
# screenshots. Without it a capture returns an oversized payload that never
# reaches the model, so inject it into the tool venv here.
WITH_PACKAGES="pillow"

# ── Self-bootstrap for interactive prompts under curl|bash ───────────────────
# Bash reads the script from stdin lazily under curl|bash, so a mid-script
# prompt would consume the script itself. Re-download to a temp file and
# re-exec with /dev/tty. Skipped when the caller asked for --non-interactive
# (nothing prompts) so CI and first-publish runs never depend on the URL
# already being live.
case " $* " in
  *" --non-interactive "*) ;;
  *)
    if [ ! -t 0 ] && [ -e /dev/tty ] && (exec </dev/tty) 2>/dev/null; then
      command -v curl >/dev/null 2>&1 || {
        echo "ERROR: curl required to self-bootstrap" >&2
        exit 1
      }
      _SCRIPT_URL="${ORVEX_OMNIGENT_SCRIPT_URL:-https://orvex.sh/install/omnigent}"
      _SCRIPT_TMP="$(mktemp -t orvex-omnigent.XXXXXX 2>/dev/null || mktemp)"
      trap 'rm -f "$_SCRIPT_TMP"' EXIT
      curl -fsSL "$_SCRIPT_URL" -o "$_SCRIPT_TMP" || {
        echo "ERROR: download failed: $_SCRIPT_URL" >&2
        exit 1
      }
      exec bash "$_SCRIPT_TMP" "$@" </dev/tty
    fi
    ;;
esac

# The checkout + wheels are built in a temp dir; drop it however we exit.
WORK_DIR=""
cleanup() { [ -n "$WORK_DIR" ] && rm -rf "$WORK_DIR"; return 0; }
trap cleanup EXIT

# ── Style ────────────────────────────────────────────────────────────────────
init_style() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$(printf '\033[1m') DIM=$(printf '\033[2m') RESET=$(printf '\033[0m')
    GREEN=$(printf '\033[32m') YELLOW=$(printf '\033[33m')
    MAGENTA=$(printf '\033[35m')
  else
    BOLD='' DIM='' RESET='' GREEN='' YELLOW='' MAGENTA=''
  fi
}

step() { printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
verbose() { [ "$VERBOSE" = true ] && printf '%s  %s%s\n' "$DIM" "$*" "$RESET" || true; }

usage() {
  printf 'Usage: install/omnigent [--release X.Y.Z] [--ref REF] [--repo URL]\n'
  printf '                        [--extra NAME] [--skip-web-ui]\n'
  printf '                        [--non-interactive] [--verbose]\n'
}

# Releases are tagged orvex-vX.Y.Z, so accept a bare or v-prefixed version and
# reject anything else here — a made-up tag would otherwise surface as an
# opaque 404 from gh. Finals only, matching what the release workflow accepts.
normalize_release() {
  case "$1" in
    orvex-v*) candidate="${1#orvex-v}" ;;
    v*) candidate="${1#v}" ;;
    *) candidate="$1" ;;
  esac
  if [[ "$candidate" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'orvex-v%s\n' "$candidate"
  else
    printf "ERROR: '%s' is not an orvex release. They are tagged orvex-vX.Y.Z — pass 0.10.0 or orvex-v0.10.0. List them with: gh release list --repo %s\n" \
      "$1" "$RELEASE_REPO" >&2
    return 1
  fi
}

# A ref (or an explicit --from-source) selects the source build; otherwise a
# released wheel is installed.
building_from_source() { [ -n "$GIT_REF" ]; }

print_banner() {
  printf '\n%sOmnigent%s %s(orvex build)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
  if building_from_source; then
    printf '%s%s@%s (source build)%s\n\n' "$DIM" "$REPO_URL" "$GIT_REF" "$RESET"
  else
    printf '%srelease %s from %s%s\n\n' "$DIM" "$RELEASE" "$RELEASE_REPO" "$RESET"
  fi
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --non-interactive) NON_INTERACTIVE=true ;;
      --verbose) VERBOSE=true ;;
      --skip-web-ui) SKIP_WEB_UI=true ;;
      # --version is kept as an alias: it named the pin before releases were
      # serialised, and a copied one-liner should keep working.
      --release | --version)
        [ "$#" -ge 2 ] || { usage >&2; exit 1; }
        RELEASE="$(normalize_release "$2")" || exit 1
        shift ;;
      --ref)
        [ "$#" -ge 2 ] || { usage >&2; exit 1; }
        GIT_REF="$2"; shift ;;
      --repo)
        [ "$#" -ge 2 ] || { usage >&2; exit 1; }
        REPO_URL="$2"; shift ;;
      --extra)
        [ "$#" -ge 2 ] || { usage >&2; exit 1; }
        if [ -n "$EXTRAS" ]; then EXTRAS="$EXTRAS,$2"; else EXTRAS="$2"; fi
        shift ;;
      -h | --help) usage; exit 0 ;;
      *) usage >&2; exit 1 ;;
    esac
    shift
  done
}

# ── Prerequisites ────────────────────────────────────────────────────────────
check_platform() {
  case "$(uname -s)" in
    Linux | Darwin) verbose "platform: $(uname -s) $(uname -m)" ;;
    *) fail "Unsupported platform: $(uname -s). Omnigent supports Linux and macOS." ;;
  esac
}

ensure_git() {
  command -v git >/dev/null 2>&1 || fail "git is required. Install it and re-run."
  verbose "git: $(git --version)"
}

ensure_uv() {
  if command -v uv >/dev/null 2>&1; then
    verbose "uv: $(uv --version)"
    return 0
  fi
  if [ "$NON_INTERACTIVE" != true ]; then
    printf 'uv is required but not installed. Install it now? [Y/n] '
    read -r reply </dev/tty || reply=y
    case "$reply" in [nN]*) fail "uv is required. See https://docs.astral.sh/uv/" ;; esac
  fi
  step "Installing uv"
  curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null 2>&1 ||
    fail "uv install failed. See https://docs.astral.sh/uv/"
  # The installer drops uv in ~/.local/bin, which may not be on PATH yet in
  # this shell.
  for candidate in "$HOME/.local/bin" "$HOME/.cargo/bin"; do
    [ -x "$candidate/uv" ] && PATH="$candidate:$PATH" && export PATH
  done
  command -v uv >/dev/null 2>&1 || fail "uv installed but not on PATH; open a new shell and re-run."
}

# Release assets live in a private repo, so fetching them needs an
# authenticated client. gh is the one most people in the org already have.
ensure_gh() {
  command -v gh >/dev/null 2>&1 ||
    fail "gh is required to download the release (the repo is private). Install GitHub CLI, or build from source with --ref mcp."
  gh auth status >/dev/null 2>&1 ||
    fail "gh is installed but not authenticated. Run 'gh auth login', or build from source with --ref mcp."
  verbose "gh: $(gh --version | head -1)"
}

# The web UI is a pnpm workspace and setup.py shells out to pnpm during the
# build, so BOTH are hard requirements on the SOURCE path. The released wheel
# ships the bundle prebuilt, which is why the default install needs neither.
check_web_toolchain() {
  building_from_source || return 0
  if [ "$SKIP_WEB_UI" = true ]; then
    warn "Skipping the web UI build (--skip-web-ui): 'omnigent server' will have no bundled UI."
    return 0
  fi
  command -v node >/dev/null 2>&1 ||
    fail "Node 22+ is required to build the web UI. Install Node, or re-run with --skip-web-ui."
  node_major="$(node --version | sed 's/^v//' | cut -d. -f1)"
  if [ "${node_major:-0}" -lt 22 ]; then
    fail "Node 22+ is required to build the web UI (found $(node --version)). Upgrade, or re-run with --skip-web-ui."
  fi
  verbose "node: $(node --version)"
  # pnpm may come from its own binary or from corepack, which setup.py also
  # accepts. Checking npm instead would pass here and fail mid-build.
  if command -v pnpm >/dev/null 2>&1; then
    verbose "pnpm: $(pnpm --version 2>/dev/null || echo present)"
  elif command -v corepack >/dev/null 2>&1; then
    verbose "pnpm: via corepack $(corepack --version)"
  else
    fail "pnpm is required to build the web UI (or corepack to supply it). Install pnpm, or re-run with --skip-web-ui."
  fi
}

check_optional_deps() {
  command -v tmux >/dev/null 2>&1 ||
    warn "tmux not found — the Claude/Codex terminal launchers need it."
  if [ "$(uname -s)" = "Linux" ] && ! command -v bwrap >/dev/null 2>&1; then
    warn "bubblewrap (bwrap) not found — harness terminals will run unsandboxed."
  fi
}

check_repo_access() {
  building_from_source || return 0
  case "$REPO_URL" in
    git@* | ssh://*) ;;
    *) return 0 ;;
  esac
  # A source install clones over SSH; failing here gives a clear cause instead
  # of a uv build error thirty seconds in.
  if ! git ls-remote --heads "$REPO_URL" >/dev/null 2>&1; then
    fail "Cannot reach $REPO_URL over SSH. Check your GitHub SSH key and repo access."
  fi
  if ! git ls-remote --heads "$REPO_URL" "$GIT_REF" 2>/dev/null | grep -q .; then
    # Not fatal: the ref may be a tag or a commit sha rather than a branch.
    warn "Ref '$GIT_REF' is not a branch on $REPO_URL — continuing (it may be a tag or commit)."
  fi
  step "Repo access confirmed ($GIT_REF)"
}

# ── Install ──────────────────────────────────────────────────────────────────
install_omnigent() {
  if building_from_source; then
    install_from_source
  else
    install_from_release
  fi
}

# The published-wheel path: no clone, no build, no Node — the same shape as
# omnigent's own installer pulling a version from PyPI.
install_from_release() {
  extras_suffix=
  [ -n "$EXTRAS" ] && extras_suffix="[$EXTRAS]"

  WORK_DIR="$(mktemp -d -t orvex-omnigent.XXXXXX)"
  dist="$WORK_DIR/dist"
  mkdir -p "$dist"

  step "Downloading omnigent $RELEASE"
  # The two SDK siblings are pinned `==`, so every wheel in the release is
  # needed for the app wheel to resolve offline from --find-links.
  if ! gh release download "$RELEASE" --repo "$RELEASE_REPO" \
    --pattern '*.whl' --dir "$dist" >/dev/null 2>&1; then
    fail "Could not download release $RELEASE from $RELEASE_REPO. Check 'gh release list --repo $RELEASE_REPO', or build from source with --ref mcp."
  fi
  verbose "$(ls "$dist" | tr '\n' ' ')"

  wheel="$(ls "$dist"/omnigent-*.whl 2>/dev/null | head -1)"
  [ -n "$wheel" ] || fail "Release $RELEASE carries no omnigent wheel."

  install_wheel "$wheel" "$dist" "$extras_suffix"
}

# Shared tail of both paths: the wheel is already built either way.
install_wheel() {
  wheel="$1"
  dist="$2"
  extras_suffix="$3"

  # Extras cannot be appended to a wheel path; a PEP 508 direct reference is
  # the form that carries them.
  if [ -n "$extras_suffix" ]; then
    target="omnigent${extras_suffix} @ file://$(cd "$(dirname "$wheel")" && pwd)/$(basename "$wheel")"
  else
    target="$wheel"
  fi

  step "Installing Omnigent${extras_suffix:+ $extras_suffix} (Python $PYTHON_VERSION)"
  # --force so a re-run upgrades in place rather than no-op'ing.
  uv tool install --force -q --python "$PYTHON_VERSION" \
    --find-links "$dist" --with "$WITH_PACKAGES" "$target"
}

install_from_source() {
  extras_suffix=
  [ -n "$EXTRAS" ] && extras_suffix="[$EXTRAS]"

  # Deliberately NOT `uv tool install git+...`. That path builds an sdist
  # first, the sdist vendors no `web/`, and setup.py then silently skips the
  # SPA build — yielding an API-only server with no web UI and a zero exit.
  # Building from a real checkout is what release-omnigent.yml does, and it is
  # the only way the bundle actually lands.
  WORK_DIR="$(mktemp -d -t orvex-omnigent.XXXXXX)"
  src="$WORK_DIR/src"
  dist="$WORK_DIR/dist"

  step "Fetching $GIT_REF"
  # --branch takes a branch or tag; a bare commit sha needs a second step.
  if ! git clone --depth 1 --branch "$GIT_REF" --quiet "$REPO_URL" "$src" 2>/dev/null; then
    git clone --quiet "$REPO_URL" "$src" || fail "Could not clone $REPO_URL"
    git -C "$src" checkout --quiet "$GIT_REF" ||
      fail "Ref '$GIT_REF' not found in $REPO_URL"
  fi
  verbose "checked out $(git -C "$src" rev-parse --short HEAD)"

  if [ "$SKIP_WEB_UI" = true ]; then
    export OMNIGENT_SKIP_WEB_UI=true
    step "Building wheels (no web UI)"
  else
    step "Building wheels + web UI"
    printf '   %sthe SPA build takes a few minutes%s\n' "$DIM" "$RESET"
  fi

  # The two SDK siblings are pinned `==` as path deps, so they must be built
  # and offered alongside the app or the install cannot resolve them.
  # --wheel is load-bearing, not a speed-up. Plain `uv build` makes the sdist
  # from the source tree and then the wheel FROM THAT SDIST; the sdist carries
  # neither `web/` nor a built bundle, so the SPA step never runs and the wheel
  # ships without a UI. --wheel builds straight from the tree, where it does.
  for pkg in "$src" "$src/sdks/python-client" "$src/sdks/ui"; do
    verbose "building $(basename "$pkg")"
    if [ "$VERBOSE" = true ]; then
      uv build --wheel "$pkg" --out-dir "$dist" || fail "Build failed: $pkg"
    else
      uv build --wheel "$pkg" --out-dir "$dist" >/dev/null 2>&1 || fail "Build failed: $pkg"
    fi
  done

  wheel="$(ls "$dist"/omnigent-*.whl 2>/dev/null | head -1)"
  [ -n "$wheel" ] || fail "No omnigent wheel was produced."

  install_wheel "$wheel" "$dist" "$extras_suffix"
}

uv_tool_bin_dir() { uv tool dir --bin 2>/dev/null || echo "$HOME/.local/bin"; }

path_contains() {
  case ":$PATH:" in *":$1:"*) return 0 ;; *) return 1 ;; esac
}

verify_omnigent() {
  bin_dir="$1"
  cli_path="$bin_dir/omnigent"
  [ -x "$cli_path" ] || cli_path="$(command -v omnigent 2>/dev/null || true)"
  [ -n "$cli_path" ] || fail "Omnigent installed, but the omnigent command was not found."
  "$cli_path" --help >/dev/null || fail "omnigent is installed but failed to run."
  step "Verified $("$cli_path" --version 2>/dev/null | head -1)"

  # Pillow is injected rather than declared, so prove it actually landed —
  # otherwise screenshot bounding is silently inert.
  tool_python="$(uv tool dir 2>/dev/null)/omnigent/bin/python"
  if [ -x "$tool_python" ] && "$tool_python" -c "import PIL" >/dev/null 2>&1; then
    verbose "pillow: present (browser screenshots will be bounded)"
  else
    warn "Pillow not detected in the tool venv — browser screenshots will not be size-bounded."
  fi

  # A wheel that quietly lacks the SPA still installs and still exits 0, and
  # the loss only shows up as an API-only page on first `omnigent server`.
  # Fail here instead. --skip-web-ui only excuses it on the source path; a
  # release wheel is expected to carry the bundle however it was requested.
  if { building_from_source && [ "$SKIP_WEB_UI" = true ]; }; then
    :
  elif [ -x "$tool_python" ]; then
    bundle="$("$tool_python" -c \
      'import pathlib,omnigent;print(pathlib.Path(omnigent.__file__).parent/"server"/"static"/"web-ui"/"index.html")' \
      2>/dev/null || true)"
    if [ -n "$bundle" ] && [ -f "$bundle" ]; then
      step "Web UI bundled"
    else
      fail "Installed, but the web UI bundle is missing — 'omnigent server' would serve an API-only page. Re-run with --verbose to see the build output, or --skip-web-ui to accept this."
    fi
  fi
}

maybe_add_bin_to_path() {
  bin_dir="$1"
  path_contains "$bin_dir" && return 0
  warn "$bin_dir is not on your PATH."
  printf '   Add it with:  %sexport PATH="%s:$PATH"%s\n' "$BOLD" "$bin_dir" "$RESET"
}

write_install_ledger() {
  bin_dir="$1"
  cli_path="$bin_dir/omnigent"
  [ -x "$cli_path" ] || cli_path="$(command -v omnigent 2>/dev/null || true)"
  [ -n "$cli_path" ] || return 0
  if "$cli_path" _internal write-ledger --from-env >/dev/null 2>&1; then
    step "Recorded install ledger"
  else
    verbose "install ledger not written (uninstall can backfill it later)"
  fi
}

print_next_steps() {
  bin_dir="$1"
  prefix=
  path_contains "$bin_dir" || prefix="PATH=\"$bin_dir:\$PATH\" "

  printf '\n%sOmnigent installed.%s\n\n' "$BOLD" "$RESET"
  printf 'Start chatting — first run sets up a model and a local web UI:\n'
  printf '  %s%somnigent%s\n\n' "$prefix" "$MAGENTA" "$RESET"
  printf 'Or launch a specific coding harness:\n'
  printf '  %somnigent claude          # Claude Code\n' "$prefix"
  printf '  %somnigent codex           # Codex\n\n' "$prefix"
  printf 'Connect this machine to an Omnigent server as a host:\n'
  if [ -n "$SERVER_URL" ]; then
    printf '  %somnigent host --server %s\n\n' "$prefix" "$SERVER_URL"
  else
    printf '  %somnigent host --server https://your-omnigent-server/\n\n' "$prefix"
  fi
  printf 'Re-run this installer any time to upgrade in place:\n'
  # Flags, never a `VAR=x curl … | bash` prefix: that assigns the variable to
  # curl alone, so the reprinted value would be silently ignored on re-run.
  if building_from_source; then
    printf '  %scurl -fsSL orvex.sh/install/omnigent | bash -s -- --ref %s%s\n' "$DIM" "$GIT_REF" "$RESET"
  else
    printf '  %scurl -fsSL orvex.sh/install/omnigent | bash%s\n' "$DIM" "$RESET"
  fi
}

main() {
  parse_args "$@"
  RELEASE="$(normalize_release "$RELEASE")" || exit 1
  init_style
  print_banner
  check_platform
  ensure_uv
  # git is only needed to clone, gh only to fetch release assets — each path
  # requires exactly one of them.
  if building_from_source; then
    ensure_git
  else
    ensure_gh
  fi
  check_web_toolchain
  check_optional_deps
  check_repo_access
  install_omnigent
  bin_dir="$(uv_tool_bin_dir)"
  verify_omnigent "$bin_dir"
  maybe_add_bin_to_path "$bin_dir"
  write_install_ledger "$bin_dir"
  print_next_steps "$bin_dir"
}

main "$@"
