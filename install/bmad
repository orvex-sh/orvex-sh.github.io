#!/usr/bin/env bash
# orvex.sh/install/bmad — fetch and run the published Orvex BMAD installer.
#
# This file is intentionally only a bootstrap shim. The Go binary owns
# provisioning, configuration, and self-update policy. Keep it compatible with
# bash 3.2, the stock bash shipped by macOS.

set -euo pipefail

# A piped shell reads its script lazily from stdin. If the installer later
# prompts, that prompt would consume the remainder of the script. Re-download
# the script and re-exec it with the real terminal as stdin. Keep this shape in
# sync with install/omnigent. Quiet and non-interactive runs must never depend
# on the script URL.
case " $* " in
  *" --non-interactive "*|*" --quiet "*) ;;
  *)
    if [ ! -t 0 ] && [ -e /dev/tty ] && (exec </dev/tty) 2>/dev/null; then
      command -v curl >/dev/null 2>&1 || { echo "ERROR: curl required to self-bootstrap" >&2; exit 1; }
      _SCRIPT_URL="${ORVEX_BMAD_SCRIPT_URL:-https://orvex.sh/install/bmad}"
      _SCRIPT_TMP="$(mktemp -t orvex-bmad.XXXXXX 2>/dev/null || mktemp)"
      trap 'rm -f "$_SCRIPT_TMP"' EXIT
      curl -fsSL "$_SCRIPT_URL" -o "$_SCRIPT_TMP" || { echo "ERROR: download failed: $_SCRIPT_URL" >&2; exit 1; }
      # exec replaces this shell, so pass the bootstrap path to the new copy;
      # its EXIT trap removes it after the actual installer exits.
      export _ORVEX_BMAD_BOOTSTRAP_TMP="$_SCRIPT_TMP"
      exec bash "$_SCRIPT_TMP" "$@" </dev/tty
    fi
    ;;
esac

_BOOTSTRAP_TMP="${_ORVEX_BMAD_BOOTSTRAP_TMP:-}"
_ASSET_TMP=""
_CHECKSUM_TMP=""
cleanup() {
  [ -z "$_ASSET_TMP" ] || rm -f -- "$_ASSET_TMP"
  [ -z "$_CHECKSUM_TMP" ] || rm -f -- "$_CHECKSUM_TMP"
  [ -z "$_BOOTSTRAP_TMP" ] || rm -f -- "$_BOOTSTRAP_TMP"
}
trap cleanup EXIT

# There is no tag in the latest/download URL. This names the channel selected
# by this shim; callers may preserve a more specific value across a chain.
export ORVEX_BMAD_BOOTSTRAPPED_VERSION="${ORVEX_BMAD_BOOTSTRAPPED_VERSION:-latest}"

if [ "$#" -eq 0 ]; then
  set -- install
fi

command -v uname >/dev/null 2>&1 || { echo "ERROR: uname required" >&2; exit 1; }
PLATFORM="$(uname -s 2>/dev/null)" || { echo "ERROR: could not determine platform" >&2; exit 1; }
ARCH="$(uname -m 2>/dev/null)" || { echo "ERROR: could not determine architecture" >&2; exit 1; }

case "$PLATFORM" in
  Linux)  _GOOS=linux ;;
  Darwin) _GOOS=darwin ;;
  *) echo "ERROR: unsupported platform '$PLATFORM' (Linux and Darwin are supported)" >&2; exit 1 ;;
esac

case "$ARCH" in
  x86_64|amd64) _GOARCH=amd64 ;;
  aarch64|arm64) _GOARCH=arm64 ;;
  *) echo "ERROR: unsupported architecture '$ARCH' (x86_64/amd64 and aarch64/arm64 are supported)" >&2; exit 1 ;;
esac

command -v curl >/dev/null 2>&1 || { echo "ERROR: curl required to download the BMAD installer" >&2; exit 1; }

_ASSET="orvex-installer-$_GOOS-$_GOARCH"
_RELEASE_BASE_URL="${ORVEX_BMAD_RELEASE_BASE_URL:-https://github.com/orvexai/orvex-installer/releases/latest/download}"
_RELEASE_BASE_URL="${_RELEASE_BASE_URL%/}"

# Resolve a gh fallback target from the release base URL. Measured: an
# anonymous request for a release asset on a private repo returns 404, which is
# indistinguishable from a genuinely missing asset, so gh is the only way to
# tell the two apart. Only a github.com URL of the documented shape has a
# fallback; a custom base (the test server, a mirror) stays pure curl so a
# local failure is never masked by reaching a different source.
_GH_REPO=""
_GH_TAG=""
case "$_RELEASE_BASE_URL" in
  https://github.com/*/releases/latest/download)
    _GH_REST="${_RELEASE_BASE_URL#https://github.com/}"
    _GH_REPO="${_GH_REST%/releases/latest/download}"
    ;;
  https://github.com/*/releases/download/*)
    _GH_REST="${_RELEASE_BASE_URL#https://github.com/}"
    _GH_TAG="${_GH_REST##*/}"
    _GH_REPO="${_GH_REST%/releases/download/*}"
    ;;
esac
# Require exactly owner/repo; anything else is not a target gh can use.
case "$_GH_REPO" in
  */*/*|*/) _GH_REPO="" ;;
  */*) ;;
  *) _GH_REPO="" ;;
esac

download_asset() {
  _da_name="$1"
  _da_dest="$2"
  # Anonymous first: a public repo needs no auth, and `curl | bash` must not
  # require gh. Deliberately no -f, so an HTTP error still yields its status.
  _da_code="$(curl -sSL -o "$_da_dest" -w '%{http_code}' "${_RELEASE_BASE_URL}/${_da_name}" 2>/dev/null)" || _da_code="000"
  case "$_da_code" in
    2??) return 0 ;;
  esac
  if [ -n "$_GH_REPO" ] && { [ "$_da_code" = "404" ] || [ "$_da_code" = "403" ]; }; then
    if command -v gh >/dev/null 2>&1; then
      if [ -n "$_GH_TAG" ]; then
        gh release download "$_GH_TAG" --repo "$_GH_REPO" --pattern "$_da_name" --output "$_da_dest" --clobber >/dev/null 2>&1 && return 0
      else
        gh release download --repo "$_GH_REPO" --pattern "$_da_name" --output "$_da_dest" --clobber >/dev/null 2>&1 && return 0
      fi
      echo "ERROR: could not download $_da_name from $_GH_REPO" >&2
      echo "       HTTP $_da_code anonymously, and 'gh release download' also failed." >&2
      echo "       If the repository is private, authenticate: gh auth login" >&2
      echo "       If it is public, no release asset named $_da_name has been published." >&2
      return 1
    fi
    echo "ERROR: HTTP $_da_code for ${_RELEASE_BASE_URL}/${_da_name}" >&2
    echo "       Either $_GH_REPO is private — in which case this URL can never work" >&2
    echo "       anonymously and GitHub CLI is required — or the asset is unpublished." >&2
    echo "       Install https://cli.github.com then run: gh auth login" >&2
    return 1
  fi
  echo "ERROR: download failed: ${_RELEASE_BASE_URL}/${_da_name} (HTTP $_da_code)" >&2
  return 1
}

_ASSET_TMP="$(mktemp -t orvex-bmad-asset.XXXXXX 2>/dev/null || mktemp)"
_CHECKSUM_TMP="$(mktemp -t orvex-bmad-checksums.XXXXXX 2>/dev/null || mktemp)"

download_asset "$_ASSET" "$_ASSET_TMP" || exit 1
download_asset "checksums.txt" "$_CHECKSUM_TMP" || exit 1

EXPECTED="$(awk -v asset="$_ASSET" '$2 == asset || $2 == "*" asset { print tolower($1); exit }' "$_CHECKSUM_TMP")"
case "$EXPECTED" in
  ''|*[!0-9a-f]*) echo "ERROR: checksums.txt has no valid SHA-256 entry for $_ASSET" >&2; exit 1 ;;
esac
[ "${#EXPECTED}" -eq 64 ] || { echo "ERROR: checksums.txt has no valid SHA-256 entry for $_ASSET" >&2; exit 1; }

if command -v sha256sum >/dev/null 2>&1; then
  _HASH_OUTPUT="$(sha256sum "$_ASSET_TMP")"
elif command -v shasum >/dev/null 2>&1; then
  _HASH_OUTPUT="$(shasum -a 256 "$_ASSET_TMP")"
else
  echo "ERROR: sha256sum or shasum -a 256 required" >&2
  exit 1
fi
IFS=' ' read -r ACTUAL _HASH_REST <<< "$_HASH_OUTPUT"
ACTUAL="$(printf '%s' "$ACTUAL" | tr '[:upper:]' '[:lower:]')"

# The downloaded file is still mktemp's non-executable file here. Do not move
# chmod above this comparison: a failed verification must never be executable.
if [ "$ACTUAL" != "$EXPECTED" ]; then
  echo "ERROR: SHA-256 mismatch for $_ASSET" >&2
  exit 1
fi

rm -f -- "$_CHECKSUM_TMP"
_CHECKSUM_TMP=""

chmod 755 "$_ASSET_TMP" || { echo "ERROR: could not make verified installer executable" >&2; exit 1; }
# A re-exec'd copy no longer needs its downloaded script source. Remove it
# before replacing this shell; the asset itself must remain because it is the
# executable being launched and cannot be cleaned up before exec.
if [ -n "$_BOOTSTRAP_TMP" ]; then
  rm -f -- "$_BOOTSTRAP_TMP"
  _BOOTSTRAP_TMP=""
fi
exec "$_ASSET_TMP" "$@"
